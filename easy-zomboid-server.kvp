Meta.DisplayName=Easy Zomboid Server (Build 42)
Meta.Description=Build 42 dedicated server with every setting explained in plain English
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=pippersgaming
Meta.URL=https://github.com/pippersgaming/zomboid-amp-template
Meta.DisplayImageSource=steam:108600
Meta.EndpointURIFormat=steam://connect/{ip}:{GenericModule.App.Ports.$GamePort}
Meta.ConfigManifest=easy-zomboid-serverconfig.json
Meta.MetaConfigManifest=easy-zomboid-servermetaconfig.json
Meta.ConfigRoot=easy-zomboid-server.kvp
Meta.MinAMPVersion=2.8.0.4
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=EarlyWorkInProgress
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.AppConfigId=e1ed60a1-4895-4648-a186-7d56c60821f9
Meta.ResourceUsageInfo=Before the first update, set the admin and RCON passwords in Configuration, Server tab, Start here: AMP won't install or start the server until both are set. Memory: the game's own launch files give the server 3 GB (ProjectZomboid64.json) or 16 GB (StartServer64.bat on Windows). For Build 42 we recommend at least 10 GB, adjusted for the mods you run.
App.DisplayName=Easy Zomboid Server (Build 42)
App.RootDir=./easy-zomboid-server/
App.BaseDirectory=./easy-zomboid-server/380870/
App.ExecutableWin=380870\jre64\bin\java.exe
App.ExecutableLinux=380870/jre64/bin/java
App.WorkingDir=380870
App.WindowsCommandLineArgs=--enable-native-access=ALL-UNNAMED --add-exports=java.base/jdk.internal.misc=ALL-UNNAMED -Dfile.encoding=UTF-8 -Djava.awt.headless=true -Dzomboid.steam=1 -Dzomboid.znetlog=1 -Duser.home=./ -Xmx{{MaxMemory}}m {{JavaGC}} {{RconLocalOnly}} -XX:-CreateCoredumpOnCrash -XX:-OmitStackTraceInFastThrow -Djava.library.path=natives/;natives/win64/;. {{CustomJavaArgs}} -cp java/*;java/;projectzomboid.jar;./
App.LinuxCommandLineArgs=--enable-native-access=ALL-UNNAMED --add-exports=java.base/jdk.internal.misc=ALL-UNNAMED -Dfile.encoding=UTF-8 -Djava.awt.headless=true -Dzomboid.steam=1 -Dzomboid.znetlog=1 -Duser.home=./ -Xmx{{MaxMemory}}m {{JavaGC}} {{RconLocalOnly}} -XX:-OmitStackTraceInFastThrow -Djava.library.path=linux64/:natives/ -Djava.security.egd=file:/dev/urandom {{CustomJavaArgs}} -cp java/:java/*:projectzomboid.jar:./
App.CommandLineArgs={{$PlatformArgs}} zombie.network.GameServer -port {{$GamePort}} -udpport {{$DirectPort}} {{$FormattedArgs}} {{PlayerTracking}} {{CustomServerArgs}}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter= 
App.AppSettings={}
App.EnvironmentVariables={"LD_LIBRARY_PATH":"{{$FullBaseDir}}linux64:{{$FullBaseDir}}natives:{{$FullBaseDir}}:{{$FullBaseDir}}jre64/lib:{{$FullBaseDir}}jre64/lib/amd64:%LD_LIBRARY_PATH%","LD_PRELOAD":"{{$FullBaseDir}}jre64/lib/libjsig.so","SteamAppId":"108600"}
App.ExitMethod=String
App.ExitString=quit
App.ExitTimeout=60
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.AdminMethod=STDIO
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[easy-zomboid-serverports.json]
App.PrimaryApplicationPortRef=GamePort
App.AdminPortRef=RCONPort
App.MaxUsers=32
App.UseRandomAdminPassword=False
App.UpdateSources=@IncludeJson[easy-zomboid-serverupdates.json]
App.PreStartStages=@IncludeJson[easy-zomboid-serverstart.json]
App.SteamUpdateAnonymousLogin=True
App.RapidStartup=False
App.SupportsUniversalSleep=False
App.CommandTriggers={"^.*CheckModsNeedUpdate: Mods need update.*$":"servermsg \"{{ModUpdateMessage}}\""}
App.ApplicationReadyMode=RegexMatch
App.StripANSIControlCodes=True
Console.AppReadyRegex=^.*SERVER STARTED.*$
Console.UserJoinRegex=^(?:LOG\s+:\s+DetailedInfo\s.*?>\s)?Player (?<username>.+)\(\d+\) joined to chat server successfully\.?$
Console.UserLeaveRegex=^(?:LOG\s+:\s+DetailedInfo\s.*?>\s)?Disconnected player "(?<username>[^"]*)" -?\d+ .+$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.FilterMatchRegex=Body='.*'(?= Socket\[)|Body='[^']*'|\b(?:\d{1,3}\.){3}\d{1,3}\b|{{HideSteamIDs}}
Console.FilterMatchReplacement=[hidden]
Console.ThrowawayMessageRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.UserActions={"Kick": "kickuser \"{{userid}}\"", "Ban": "banuser \"{{userid}}\""}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
