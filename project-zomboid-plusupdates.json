        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"cd '{{$FullRootDir}}' && cp -f linux32/steamclient.so 380870/ 2>/dev/null; cp -f linux64/steamclient.so 380870/linux64/ 2>/dev/null; exit 0\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Copy Steam client files",
        "UpdateSourcePlatform": "Windows",
        "UpdateSource": "Executable",
        "UpdateSourceData": "cmd.exe",
        "UpdateSourceArgs": "/c cd /d \"{{$FullRootDir}}\" && for %f in (steamclient.dll steamclient64.dll tier0_s.dll tier0_s64.dll vstdlib_s.dll vstdlib_s64.dll) do @if exist %f copy /y %f 380870\\ >nul",
        "SkipOnFailure": false
